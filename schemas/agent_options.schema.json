{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsa.example/schemas/agent_options.schema.json",
  "title": "Agent Loop Options",
  "description": "Effective, validated configuration for the bounded AGENT_LOOP stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "tier",
    "requested_tier",
    "runtime",
    "max_candidates",
    "max_steps",
    "max_steps_per_candidate",
    "max_tool_calls",
    "max_seconds",
    "no_progress_limit",
    "max_action_failures",
    "max_binary_size_mb",
    "disabled_reason",
    "limitations",
    "model",
    "dynamic",
    "external"
  ],
  "properties": {
    "enabled": {"type": "boolean"},
    "tier": {"enum": ["standard", "dynamic", "external"]},
    "requested_tier": {"enum": ["standard", "dynamic", "external"]},
    "runtime": {"type": "string"},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 500},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 5000},
    "max_steps_per_candidate": {"type": "integer", "minimum": 1, "maximum": 20},
    "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "no_progress_limit": {"type": "integer", "minimum": 1, "maximum": 10},
    "max_action_failures": {"type": "integer", "minimum": 1, "maximum": 10},
    "max_binary_size_mb": {"type": "integer", "minimum": 1, "maximum": 4096},
    "disabled_reason": {"type": ["string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_calls", "max_tokens", "allow_public"],
      "properties": {
        "enabled": {"enum": [true, false, "auto"]},
        "max_calls": {"type": "integer", "minimum": 1, "maximum": 2000},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "allow_public": {"type": "boolean"}
      }
    },
    "dynamic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "require_authorized_emulation", "qemu_load_check"],
      "properties": {
        "enabled": {"type": "boolean"},
        "require_authorized_emulation": {"type": "boolean"},
        "qemu_load_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout_s"],
          "properties": {
            "timeout_s": {"type": "integer", "minimum": 1, "maximum": 300}
          }
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "klee", "bond"],
      "properties": {
        "enabled": {"type": "boolean"},
        "klee": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "max_time_s", "max_forks", "max_depth", "solver"],
          "properties": {
            "enabled": {"type": "boolean"},
            "max_time_s": {"type": "integer", "minimum": 1, "maximum": 14400},
            "max_forks": {"type": "integer", "minimum": 1, "maximum": 1024},
            "max_depth": {"type": "integer", "minimum": 1, "maximum": 1000},
            "solver": {"enum": ["z3", "stp"]}
          }
        },
        "bond": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    }
  }
}
